<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.gregfelice.Nightpanel</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Daily Driver</name>
  <summary>Visual keyboard configuration for GNOME</summary>
  <description>
    <p>
      Daily Driver provides a videogame-like options UI for keyboard configuration.
      Easily customize your keyboard shortcuts, create profiles, and configure
      Mac keyboards on Linux.
    </p>
    <p>Features:</p>
    <ul>
      <li>Visual keyboard display with shortcut overlay</li>
      <li>Profile system for saving and sharing configurations</li>
      <li>Built-in presets (Vanilla GNOME, Mac-like, Hyprland-style)</li>
      <li>Mac keyboard support (hid-apple configuration)</li>
      <li>Conflict detection and resolution</li>
      <li>Tiling Assistant integration</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.gregfelice.Nightpanel.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/gregfelice/nightpanel/main/data/screenshots/main-window.png</image>
      <caption>Main window with visual keyboard layout</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/gregfelice/nightpanel/main/data/screenshots/keyboard-view.png</image>
      <caption>Keyboard view showing shortcut overlay</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/gregfelice/nightpanel/main/data/screenshots/cheat-sheet.png</image>
      <caption>Cheat sheet overlay for quick reference</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/gregfelice/nightpanel/main/data/screenshots/presets.png</image>
      <caption>Built-in preset profiles</caption>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/gregfelice/nightpanel</url>
  <url type="bugtracker">https://github.com/gregfelice/nightpanel/issues</url>
  <url type="vcs-browser">https://github.com/gregfelice/nightpanel</url>

  <developer id="io.github.gregfelice">
    <name>Greg Felice</name>
  </developer>

  <branding>
    <color type="primary" scheme_preference="light">#62a0ea</color>
    <color type="primary" scheme_preference="dark">#1c71d8</color>
  </branding>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="0.3.0" date="2026-10-20">
      <description>
        <p>Nightpanel now reports a failed toggle instead of recording it as
        a success. Every theming adapter is held to the same rules by a test
        suite that checks them automatically: a failed command or an
        unwritable file stops the toggle, and turning the theme off restores
        exactly what was there before rather than a guess.</p>
        <p>The panel icons no longer disappear when the system icon theme is
        set to hicolor; Nightpanel falls back to Adwaita for its own windows.</p>
        <p>Upgrade note: if the theme was turned on by an earlier version,
        turn it off once with that version before upgrading, or the first
        revert after upgrading will refuse and ask for a fresh toggle.</p>
      </description>
    </release>
    <release version="0.2.9" date="2026-09-05">
      <description>
        <p>Packaging only, with no change to the application itself. The
        release restores the path that publishes Nightpanel to its apt
        repository, and makes that repository reachable from outside the
        local network again.</p>
      </description>
    </release>
    <release version="0.2.8" date="2026-08-30">
      <description>
        <p>Firefox: the vertical-tabs sidebar is hidden at startup again and
        summoned with Ctrl+Alt+Z, instead of being disabled outright.</p>
      </description>
    </release>
    <release version="0.2.7" date="2026-06-15">
      <description>
        <p>Configurator navigation fixes and reliability work:</p>
        <ul>
          <li>Escape now closes the configurator window instead of jumping between unrelated tabs.</li>
          <li>Ctrl+Tab / Ctrl+Shift+Tab cycle through the tabs in order, keeping the tab bar in sync.</li>
          <li>Added test coverage across the theming adapters and orchestrator.</li>
        </ul>
      </description>
    </release>
    <release version="0.2.6" date="2026-06-10">
      <description>
        <p>Theming fixes and a new control:</p>
        <ul>
          <li>GNOME desktop now blacks out to a solid canvas (fixes a black-to-blue gradient).</li>
          <li>New "video brightness" slider dims YouTube / HTML5 video in Firefox, independently of page brightness.</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-03-05">
      <description>
        <p>New release</p>
      </description>
    </release>
    <release version="0.2.0" date="2026-03-05">
      <description>
        <p>revised update with bug fixes</p>
      </description>
    </release>
    <release version="0.2.0" date="2026-03-04">
      <description>
        <p>Major update: Fixed core logic, restored test suite, and added Snap/Flatpak distribution tooling.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-01-28">
      <description>
        <p>Initial release with core features:</p>
        <ul>
          <li>GSettings shortcut management for GNOME, apps, and extensions</li>
          <li>Visual keyboard display with shortcut overlay</li>
          <li>Profile system for saving and sharing configurations</li>
          <li>Built-in presets: Vanilla GNOME, Mac-like, Hyprland-style</li>
          <li>Mac keyboard support with hid-apple configuration</li>
          <li>Tiling Assistant integration</li>
        </ul>
      </description>
    </release>
  </releases>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>

  <categories>
    <category>Settings</category>
    <category>HardwareSettings</category>
  </categories>

  <keywords>
    <keyword>keyboard</keyword>
    <keyword>shortcuts</keyword>
    <keyword>keybindings</keyword>
    <keyword>hotkeys</keyword>
    <keyword>gnome</keyword>
    <keyword>configuration</keyword>
  </keywords>
</component>
